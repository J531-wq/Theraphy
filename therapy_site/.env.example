SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
GROQ_API_KEY=

# Database (leave empty in dev = SQLite; set on VPS for PostgreSQL)
DATABASE_URL=

# ZeptoMail SMTP
EMAIL_HOST=smtp.zeptomail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=your-zepto-api-key-here
DEFAULT_FROM_EMAIL=info@mytherapydoctor.com
ADMIN_EMAIL=info@mytherapydoctor.com
EMAIL_TIMEOUT=30

# ---- PRODUCTION-ONLY SETTINGS (uncomment on the VPS) ----
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,VPS_IP
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# DATABASE_URL=postgresql://therapy_user:strongpassword@localhost:5432/therapy_db
